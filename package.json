{
  "name": "shattered-plains-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "start": "npm run build && node outputs/convex-static-server.js",
    "dev": "npx convex dev",
    "preview": "npm run build && node outputs/convex-static-server.js dist",
    "convex:dev": "npx convex dev",
    "convex:deploy": "npx convex deploy",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:update": "node scripts/run-e2e.mjs --update-snapshots"
  },
  "dependencies": {
    "@convex-dev/auth": "latest",
    "convex": "^1.42.1",
    "web-push": "^3.6.7"
  },
  "allowScripts": {
    "esbuild@0.27.0": true
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.62.1",
    "@types/web-push": "^3.6.4",
    "convex-test": "^0.0.54",
    "vitest": "^4.1.10"
  }
}
